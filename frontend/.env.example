# =============================================================================
# FRONTEND ENVIRONMENT CONFIGURATION - EXAMPLE
# =============================================================================
# Copy this file to .env for local development
# For production, set these as environment variables in your deployment platform
# =============================================================================
# Vite exposes all VITE_ prefixed variables to the client-side code.
# DO NOT put sensitive data here - it WILL be visible in the browser.
# =============================================================================

# Environment (development | production)
VITE_ENV=development

# =============================================================================
# API CONFIGURATION
# =============================================================================
# Development: http://localhost:5000/api/v1
# Production: https://api.yourdomain.com/api/v1
VITE_API_BASE_URL=http://localhost:5000/api/v1

# WebSocket URL for real-time features (chat, notifications)
# Development: ws://localhost:5000
# Production: wss://api.yourdomain.com
VITE_WS_URL=ws://localhost:5000

# Chat Service URL for Socket.IO connection
# Development: http://localhost:3008
# Production: https://chat.yourdomain.com (or your chat service URL)
VITE_CHAT_SERVICE_URL=http://localhost:3008

# =============================================================================
# APP CONFIGURATION
# =============================================================================
VITE_APP_NAME=TripAndEvent
VITE_APP_VERSION=1.0.0

# =============================================================================
# MEDIA/CDN CONFIGURATION
# =============================================================================
# Leave empty for local development (serves from /public/assets)
# Set to S3/CDN URL for production (e.g., https://your-bucket.s3.region.amazonaws.com)
VITE_MEDIA_URL=

# =============================================================================
# PAYMENT INTEGRATION
# =============================================================================
# Razorpay - Get keys from https://dashboard.razorpay.com/app/keys
# Use test mode keys for development, live keys for production
VITE_RAZORPAY_KEY_ID=

# =============================================================================
# OAUTH CONFIGURATION (Public Client IDs only - NOT secrets!)
# =============================================================================
# Google OAuth - Get from https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID -> Web application
# Add authorized JavaScript origins: http://localhost:5173 (dev), https://yourdomain.com (prod)
VITE_GOOGLE_CLIENT_ID=

# Facebook OAuth - Get from https://developers.facebook.com/apps
# Create App -> Settings -> Basic -> App ID
VITE_FACEBOOK_APP_ID=

# =============================================================================
# FEATURE FLAGS
# =============================================================================
VITE_ENABLE_CHAT=true
VITE_ENABLE_GROUPS=true
VITE_ENABLE_PAYMENTS=true
VITE_ENABLE_NOTIFICATIONS=true

# =============================================================================
# DEBUG & DEVELOPMENT
# =============================================================================
# Enable debug logging (disable in production)
VITE_DEBUG=false

# =============================================================================
# ANALYTICS (Optional - Production only)
# =============================================================================
# VITE_GA_TRACKING_ID=UA-XXXXXXXXX-X
# VITE_MIXPANEL_TOKEN=

# =============================================================================
# ERROR TRACKING (Optional - Production only)
# =============================================================================
# VITE_SENTRY_DSN=https://xxx@sentry.io/xxx
