# Chatbot Service Environment Variables

# Node environment
NODE_ENV=development

# Server port
PORT=3013

# Database connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tne_chatbotdb?schema=public

# JWT Secret (shared across services)
JWT_SECRET=your-super-secret-jwt-key-min-64-characters-long-for-security

# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_TEMPERATURE=0.3

# CRM Sync Service URL (source of truth for catalog data)
CRMSYNC_SERVICE_URL=http://localhost:3011

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:5000

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Session Configuration
SESSION_TIMEOUT_HOURS=24
