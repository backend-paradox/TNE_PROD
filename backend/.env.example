# =============================================================================
# BACKEND SHARED ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values.
# For production, set these as environment variables in your deployment platform.
# =============================================================================

NODE_ENV=development

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password

# Service-specific database names
AUTH_DB_NAME=tne_authdb
USER_DB_NAME=tne_userdb
BOOKING_DB_NAME=tne_bookingdb
PAYMENT_DB_NAME=tne_paymentdb
GROUP_DB_NAME=tne_groupdb
CHAT_DB_NAME=tne_chatdb
NOTIFICATION_DB_NAME=tne_notificationdb
PACKAGE_DB_NAME=tne_packagedb

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
# SECURITY: Generate strong secrets for production (minimum 64 characters)
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
#
# WARNING: In production, the app will REJECT secrets that:
# - Are less than 64 characters
# - Contain patterns like 'dev_', 'test_', 'change_in_production', 'placeholder'
#
JWT_SECRET=your_jwt_secret_min_64_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_64_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=7

# =============================================================================
# SERVICE PORTS
# =============================================================================
API_GATEWAY_PORT=5000
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
BOOKING_SERVICE_PORT=3004
PAYMENT_SERVICE_PORT=3005
GROUP_SERVICE_PORT=3006
NOTIFICATION_SERVICE_PORT=3007
CHAT_SERVICE_PORT=3008
CRMSYNC_SERVICE_PORT=3011
PACKAGE_SERVICE_PORT=3012

# =============================================================================
# SERVICE DISCOVERY
# =============================================================================
# Development: http://localhost:PORT
# Production: http://service-name:PORT (Docker) or internal URLs
API_GATEWAY_URL=http://localhost:5000
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
BOOKING_SERVICE_URL=http://localhost:3004
PAYMENT_SERVICE_URL=http://localhost:3005
GROUP_SERVICE_URL=http://localhost:3006
NOTIFICATION_SERVICE_URL=http://localhost:3007
CHAT_SERVICE_URL=http://localhost:3008
CRMSYNC_SERVICE_URL=http://localhost:3011
PACKAGE_SERVICE_URL=http://localhost:3012

# =============================================================================
# FRONTEND URL
# =============================================================================
FRONTEND_URL=http://localhost:5173

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@domain.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@tripandevent.com

# =============================================================================
# OAUTH CONFIGURATION
# =============================================================================
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook: https://developers.facebook.com/apps
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# =============================================================================
# PAYMENT CONFIGURATION
# =============================================================================
# WARNING: In production, test keys (rzp_test_*) will be REJECTED
# Use live keys: rzp_live_xxxxx
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret

# =============================================================================
# REDIS
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =============================================================================
# SECURITY
# =============================================================================
SALT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME_MINUTES=15
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=info

# =============================================================================
# FILE UPLOADS
# =============================================================================
UPLOAD_PROVIDER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-bucket-name
